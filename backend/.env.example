POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=fit123
POSTGRES_DB=fitness_ai_db

# "require" for managed Postgres providers (e.g. Render) that mandate SSL;
# leave as "disable" for local development.
POSTGRES_SSL_MODE=disable

DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

JWT_SECRET_KEY=changeme-use-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of origins allowed to call this API (CORS).
# In production, set this to the deployed frontend's origin, e.g.
# https://fitness-ai-frontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
