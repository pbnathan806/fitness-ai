# Base URL the frontend calls for the API.
# Local dev: leave as /api/v1 - the Vite dev server proxies it to the backend
# (see vite.config.ts, defaults to http://localhost:8000; override with
# VITE_API_PROXY_TARGET if the backend runs elsewhere).
# Production (e.g. Render static site): set to the deployed backend's full
# origin, e.g. https://fitness-ai-backend.onrender.com/api/v1 - this requires
# CORS to be enabled on that backend for the frontend's origin.
VITE_API_BASE_URL=/api/v1
